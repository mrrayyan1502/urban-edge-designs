{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.urban-edge-designs.com"
        }
      ],
      "destination": "https://urban-edge-designs.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.urban-edge-designs.com"
        }
      ],
      "destination": "https://urban-edge-designs.com/$1",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/demos/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/rss.xml", "destination": "/rss.xml" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
